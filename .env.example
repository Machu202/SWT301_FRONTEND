# Local development: leave VITE_API_BASE_URL empty so Vite proxies /api to localhost:8080.
# Production: set only a trusted HTTPS backend origin. Do not append /api.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# API logs are already enabled during `npm run dev`; production remains disabled unless explicitly enabled.
VITE_ENABLE_API_LOGS=false
